# Скопируйте в .env и при необходимости поменяйте. Только для локальной разработки.
# Файл читают и docker compose, и Makefile.
#
# - Логины, пароли и имя базы применяются только при первом создании volume;
#   после их смены нужен `docker compose down -v` (удалит локальные данные).
# - Значения подставляются в строки подключения как есть: только буквы, цифры
#   и - _ . ~, без кавычек, пробелов, $ и #, без комментариев в конце строки.

POSTGRES_USER=dd
POSTGRES_PASSWORD=dd
POSTGRES_DB=dd
POSTGRES_PORT=5432

REDIS_PORT=6379

RABBITMQ_USER=dd
RABBITMQ_PASSWORD=dd
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

PROMETHEUS_PORT=9090

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000

# api в Docker
API_PORT=8080

# Приложение (api и worker). В Docker адреса зависимостей задаёт compose;
# при запуске через make run они собираются из переменных выше.
LOG_LEVEL=info
# Только для make run / make run-worker: в Docker они зафиксированы в
# docker-compose.yml (порт 8080; таймаут меньше stop_grace_period).
# HTTP_ADDR=:8080
# SHUTDOWN_TIMEOUT=15s
