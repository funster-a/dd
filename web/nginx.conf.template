server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # CSP: всё своё, кроме обложек из S3 (MEDIA_ORIGIN). Инлайновые стили
    # нужны Vue-привязкам :style, скриптов со стороны нет.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${MEDIA_ORIGIN}; media-src 'self' ${MEDIA_ORIGIN}; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${MEDIA_ORIGIN}; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # DNS контейнера из /etc/resolv.conf (образ nginx подставляет его в
    # NGINX_LOCAL_RESOLVERS): в Docker это 127.0.0.11, в Kubernetes — DNS
    # кластера (ADR 032). Имя upstream переразрешается каждые 10 секунд.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /v1/ {
        set $api ${API_UPSTREAM};
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        client_max_body_size 1m;
    }

    # Файлы сборки с хешем в имени не меняются никогда.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Маршруты SPA: /e/…, /orders/…, /t/… — всё отдаёт index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: ${MEDIA_ORIGIN}; media-src 'self' ${MEDIA_ORIGIN}; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ${MEDIA_ORIGIN}; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri /index.html;
    }
}
